# CivicResolve AI runtime configuration. No API keys are required.
# Values are read from process environment variables; this file is a reference.

# Development default. Use explicit comma-separated origins in integrated deployments.
CIVICRESOLVE_CORS_ORIGINS=*

# Free local Hugging Face model loaded lazily on the first vision request.
CIVICRESOLVE_SIGLIP_MODEL_ID=google/siglip-base-patch16-224

# Maximum size in megabytes for each uploaded image.
CIVICRESOLVE_MAX_UPLOAD_MB=10
